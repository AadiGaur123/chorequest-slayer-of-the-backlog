# ChoreQuest Environment Configuration

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DEMO_MODE: Set to 'false' when connecting live OAuth credentials.
# Set to 'true' for zero-auth mock testing & grading.
DEMO_MODE=true

SESSION_SECRET=hackathon-super-secret-key-change-in-prod

# Google OAuth2 (Gmail API)
# Scope required: https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# GitHub OAuth App
# Scopes required: repo, workflow
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/github/callback
